PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_KEY=replace-with-a-long-random-admin-key

# Separate FastAPI RapidOCR/ONNX service used by POST /api/scan.
OCR_SERVICE_URL=http://localhost:8000
OCR_TIMEOUT_MS=45000

# Required only if Google sign-in is enabled.
GOOGLE_CLIENT_ID=

# Optional UPI subscription settings.
UPI_ID=
UPI_PAYEE_NAME=WoodApp
SUBSCRIPTION_DAYS=30
SUBSCRIPTION_AMOUNT_INR=499

# Required for SQLite on a cloud host with persistent storage.
# Render Free web services cannot attach a persistent disk. Use Postgres instead,
# or upgrade the web service and attach a disk mounted at /var/data.
# DB_PATH=/var/data/woodapp.db
DB_PATH=
