PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_KEY=replace-with-a-long-random-admin-key

# At least one AI key is required.
GEMINI_API_KEY=
GROQ_API_KEY=

# Required only if Google sign-in is enabled.
GOOGLE_CLIENT_ID=

# Optional UPI subscription settings.
UPI_ID=
UPI_PAYEE_NAME=WoodApp
SUBSCRIPTION_DAYS=30
SUBSCRIPTION_AMOUNT_INR=499

# Use this when the cloud host provides persistent storage.
# Example for a Render persistent disk:
# DB_PATH=/var/data/woodapp.db
DB_PATH=
