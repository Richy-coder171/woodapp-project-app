peating-linear-gradient(12deg, rgba(0,0,0,0.12) 0 1px, transparent 1px 11px);\n  mix-blend-mode: overlay;\n}\n\nbutton,\ninput {\n  font: inherit;\n}\n\nbutton {\n  touch-action: manipulation;\n}\n\ni {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  font-family: var(--font-mono);\n  font-style: normal;\n  line-height: 1;\n}\n\n#root {\n  width: 100%;\n  min-height: 100dvh;\n  display: flex;\n  justify-content: center;\n}\n\n#app {\n  width: 100%;\n  max-width: 480px;\n  height: 100dvh;\n  min-height: 620px;\n  display: flex;\n  flex-direction: column;\n  position: relative;\n  overflow: hidden;\n  background:\n    linear-gradient(rgba(255,255,255,0.22) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(255,255,255,0.18) 1px, transparent 1px),\n    radial-gradient(circle at 18% 0%, rgba(184, 121, 51, 0.16), transparent 34%),\n    var(--paper);\n  background-size: 100% 31px, 31px 100%, auto, auto;\n  box-shadow: 0 28px 80px rgba(0, 0, 0, 0.45);\n}\n\n#app::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  background:\n    repeating-linear-gradient(16deg, rgba(71, 51, 24, 0.035) 0 2px, transparent 2px 9px),\n    linear-gradient(90deg, rgba(47, 95, 72, 0.08), transparent 36%, rgba(184, 121, 51, 0.08));\n}\n\n@media (min-width: 560px) {\n  #root {\n    align-items: center;\n    padding: 18px 0;\n  }\n\n  #app {\n    height: calc(100dvh - 36px);\n    min-height: 680px;\n    border: 1px solid rgba(255, 250, 240, 0.18);\n  }\n}\n\n/* ===== HEADER ===== */\nheader {\n  position: sticky;\n  top: 0;\n  z-index: 20;\n  padding: 18px 18px 15px;\n  border-bottom: 1px solid var(--border-strong);\n  background:\n    linear-gradient(90deg, rgba(47, 95, 72, 0.14), transparent 48%, rgba(184, 121, 51, 0.16)),\n    var(--paper-warm);\n  box-shadow: 0 10px 22px rgba(31, 24, 14, 0.12);\n}\n\nheader::after {\n  content: \"\";\n  position: absolute;\n  left: 18px;\n  right: 18px;\n  bottom: 6px;\n  height: 1px;\n  background: repeating-linear-gradient(90deg, var(--ink) 0 12px, transparent 12px 20px);\n  opacity: 0.22;\n}\n\n.brand-lockup {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  margin-bottom: 10px;\n}\n\n.brand-mark {\n  width: 30px;\n  height: 30px;\n  display: inline-grid;\n  place-items: center;\n  border: 2px solid var(--ink);\n  background: var(--moss);\n  color: var(--white);\n  font-family: var(--font-display);\n  font-size: 18px;\n  font-weight: 800;\n  box-shadow: 4px 4px 0 var(--brass);\n}\n\n.brand-kicker,\n.eyebrow {\n  color: var(--moss-dark);\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0;\n}\n\nheader h1 {\n  color: var(--ink);\n  font-family: var(--font-display);\n  font-size: 25px;\n  font-weight: 800;\n  line-height: 1.02;\n  letter-spacing: 0;\n}\n\n.formula-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  max-width: 100%;\n  margin-top: 10px;\n  padding: 7px 10px;\n  border: 1px solid rgba(47, 95, 72, 0.34);\n  border-left: 4px solid var(--moss);\n  background: rgba(255, 250, 240, 0.56);\n  color: var(--ink-soft);\n  font-family: var(--font-mono);\n  font-size: 11px;\n  line-height: 1.35;\n}\n\n.formula-badge i {\n  color: var(--brass-dark);\n}\n\n/* ===== SCREEN WRAPPER ===== */\n.screen {\n  flex: 1;\n  min-height: 0;\n  position: relative;\n  z-index: 1;\n  display: flex;\n  flex-direction: column;\n  animation: ledgerIn var(--t-slow) both;\n}\n\n@keyframes ledgerIn {\n  from {\n    opacity: 0;\n    transform: translateY(16px);\n    filter: saturate(0.8);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n    filter: saturate(1);\n  }\n}\n\n/* ===== SHARED CONTROLS ===== */\n.btn-primary,\n.btn-secondary,\n.btn-outline,\n.btn-cta,\n.action-btn,\n.btn-ghost,\n.rm-btn,\n.manual-row button,\n.server-retry,\n.cam-btn,\n.shutter-btn,\n.admin-back-btn {\n  cursor: pointer;\n  border: 0;\n  border-radius: var(--radius-control);\n  transition:\n    transform var(--t-fast),\n    background var(--t-fast),\n    border-color var(--t-fast),\n    color var(--t-fast),\n    box-shadow var(--t-fast);\n}\n\n.btn-primary,\n.btn-cta {\n  min-height: 50px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  padding: 14px 18px;\n  background: var(--moss);\n  color: var(--white);\n  border: 1px solid var(--moss-dark);\n  box-shadow: 5px 5px 0 rgba(29, 61, 48, 0.28);\n  font-weight: 700;\n  font-size: 15px;\n  overflow: hidden;\n  position: relative;\n}\n\n.btn-primary::after,\n.btn-cta::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  transform: translateX(-120%) skewX(-18deg);\n  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.22), transparent);\n  transition: transform 520ms ease;\n}\n\n.btn-primary:hover::after,\n.btn-cta:hover::after {\n  transform: translateX(120%) skewX(-18deg);\n}\n\n.btn-primary:hover,\n.btn-cta:hover {\n  background: var(--moss-dark);\n  transform: translate(-1px, -1px);\n  box-shadow: 7px 7px 0 rgba(29, 61, 48, 0.22);\n}\n\n.btn-primary:active,\n.btn-cta:active,\n.btn-secondary:active,\n.btn-outline:active,\n.action-btn:active,\n.cam-btn:active,\n.shutter-btn:active {\n  transform: translateY(1px) scale(0.99);\n}\n\n.btn-primary:disabled,\n.action-btn:disabled {\n  cursor: not-allowed;\n  opacity: 0.58;\n  box-shadow: none;\n}\n\n.btn-cta {\n  width: min(100%, 320px);\n  align-self: center;\n  font-size: 16px;\n}\n\n.btn-primary i,\n.btn-cta i,\n.btn-secondary i,\n.btn-outline i,\n.action-btn i,\n.btn-ghost i {\n  width: 24px;\n  height: 24px;\n  border: 1px solid currentColor;\n  font-size: 12px;\n}\n\n.btn-secondary,\n.btn-outline {\n  min-height: 46px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 12px 14px;\n  background: rgba(255, 250, 240, 0.45);\n  color: var(--moss-dark);\n  border: 1px solid rgba(47, 95, 72, 0.28);\n  font-weight: 700;\n}\n\n.btn-secondary:hover,\n.btn-outline:hover {\n  border-color: var(--moss);\n  background: var(--moss-light);\n}\n\n.btn-ghost {\n  min-height: 34px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  padding: 7px 10px;\n  background: transparent;\n  color: var(--ink-soft);\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.btn-ghost:hover {\n  color: var(--moss-dark);\n  background: rgba(47, 95, 72, 0.09);\n}\n\n.admin-back-btn {\n  position: fixed;\n  top: 12px;\n  left: 12px;\n  z-index: 1100;\n  padding: 8px 13px;\n  background: var(--moss);\n  color: var(--white);\n  border: 1px solid var(--moss-dark);\n  font-weight: 700;\n  box-shadow: 4px 4px 0 rgba(0,0,0,0.25);\n}\n\n/* ===== AUTH SCREEN ===== */\n.auth-screen,\n.sub-screen,\n.offline-screen,\n.loading-screen,\n.skeleton-screen {\n  align-items: center;\n  justify-content: center;\n  gap: 18px;\n  padding: 28px 22px;\n}\n\n.auth-hero,\n.sub-hero,\n.history-header {\n  width: 100%;\n  text-align: left;\n}\n\n.auth-hero h2,\n.sub-hero h2,\n.history-header h2,\n.offline-screen h2,\n.loading-screen h2 {\n  margin-top: 5px;\n  color: var(--ink);\n  font-family: var(--font-display);\n  font-size: 25px;\n  font-weight: 800;\n  line-height: 1.08;\n  letter-spacing: 0;\n}\n\n.auth-card,\n.sub-card {\n  width: 100%;\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-card);\n  background:\n    linear-gradient(180deg, rgba(255,255,255,0.48), rgba(255,255,255,0.08)),\n    var(--paper-warm);\n  box-shadow: 8px 8px 0 rgba(58, 51, 40, 0.1);\n  padding: 18px;\n}\n\n.auth-card {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.server-status {\n  min-height: 34px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 8px 10px;\n  border: 1px solid var(--border-hair);\n  background: rgba(255, 250, 240, 0.5);\n  color: var(--muted);\n  font-family: var(--font-mono);\n  font-