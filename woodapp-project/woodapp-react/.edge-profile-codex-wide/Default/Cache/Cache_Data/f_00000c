n  align-items: flex-start;\n  gap: 8px;\n  border: 1px solid rgba(155, 62, 47, 0.28);\n  border-left: 4px solid var(--rust);\n  background: var(--rust-soft);\n  color: #69291f;\n  border-radius: var(--radius-control);\n  padding: 10px 12px;\n  font-size: 13px;\n  line-height: 1.45;\n  white-space: pre-line;\n}\n\n.auth-err i,\n.err-box i,\n.rate-warn i {\n  width: 20px;\n  height: 20px;\n  border: 1px solid currentColor;\n  font-size: 11px;\n  margin-top: 1px;\n}\n\n/* ===== SUBSCRIPTION ===== */\n.sub-card {\n  padding: 0;\n  overflow: hidden;\n}\n\n.sub-row {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 10px;\n  padding: 13px 15px;\n  border-bottom: 1px solid var(--border-hair);\n}\n\n.sub-row:last-child {\n  border-bottom: 0;\n}\n\n.sub-label,\n.sub-value {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  min-width: 0;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.sub-label {\n  color: var(--ink-soft);\n}\n\n.sub-label i {\n  width: 20px;\n  height: 20px;\n  color: var(--brass-dark);\n  border: 1px solid rgba(116, 71, 28, 0.25);\n  font-size: 10px;\n}\n\n.sub-value {\n  max-width: 190px;\n  justify-content: flex-end;\n  color: var(--moss-dark);\n  text-align: right;\n  font-family: var(--font-mono);\n  font-size: 11px;\n}\n\n.sub-value.status-inactive {\n  color: var(--rust);\n}\n\n.sub-value.status-expired {\n  color: var(--brass-dark);\n}\n\n.sub-actions {\n  width: 100%;\n  display: grid;\n  gap: 10px;\n}\n\n/* ===== IDLE ===== */\n.idle-screen {\n  justify-content: center;\n  gap: 18px;\n  padding: 26px 22px 24px;\n}\n\n.idle-panel {\n  position: relative;\n  padding: 24px 18px 18px;\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-card);\n  background:\n    linear-gradient(90deg, rgba(47, 95, 72, 0.10), transparent 55%),\n    linear-gradient(180deg, rgba(255,255,255,0.5), rgba(255,255,255,0.08)),\n    var(--paper-warm);\n  box-shadow: 10px 10px 0 rgba(116, 71, 28, 0.1);\n  overflow: hidden;\n}\n\n.idle-panel::before {\n  content: \"FIELD\";\n  position: absolute;\n  right: -8px;\n  top: 18px;\n  padding: 5px 12px;\n  border: 2px solid rgba(155, 62, 47, 0.38);\n  color: rgba(155, 62, 47, 0.62);\n  font-family: var(--font-mono);\n  font-size: 22px;\n  font-weight: 600;\n  transform: rotate(9deg);\n}\n\n.idle-panel h2 {\n  max-width: 310px;\n  margin-top: 8px;\n  color: var(--ink);\n  font-family: var(--font-display);\n  font-size: 31px;\n  font-weight: 800;\n  line-height: 1.02;\n  letter-spacing: 0;\n}\n\n.instrument-strip {\n  height: 56px;\n  display: flex;\n  align-items: flex-end;\n  gap: 8px;\n  margin: 20px 0 14px;\n  padding: 0 4px;\n  border-bottom: 2px solid var(--ink);\n}\n\n.instrument-strip span {\n  width: 2px;\n  height: 17px;\n  background: var(--ink);\n  opacity: 0.6;\n}\n\n.instrument-strip span.major {\n  height: 34px;\n  background: var(--moss);\n  opacity: 1;\n}\n\n.idle-hint {\n  color: var(--muted);\n  font-size: 14px;\n  line-height: 1.45;\n  font-weight: 600;\n}\n\n.idle-actions {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 7px;\n}\n\n.user-badge,\n.scan-badge {\n  max-width: 100%;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  padding: 7px 12px;\n  border: 1px solid var(--border-hair);\n  background: rgba(255, 250, 240, 0.5);\n  color: var(--ink-soft);\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 600;\n  text-align: center;\n}\n\n.user-badge span:last-child {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.user-badge .dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--moss);\n  box-shadow: 0 0 0 3px rgba(47, 95, 72, 0.14);\n}\n\n.scan-badge {\n  color: var(--brass-dark);\n  background: rgba(184, 121, 51, 0.12);\n}\n\n.scan-badge i {\n  width: 18px;\n  height: 18px;\n  border: 1px solid currentColor;\n  font-size: 10px;\n}