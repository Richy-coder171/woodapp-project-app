{
  "name": "woodapp-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "network:update": "powershell -ExecutionPolicy Bypass -File ../scripts/update-network.ps1",
    "android:fix-java": "powershell -ExecutionPolicy Bypass -File ../scripts/fix-android-java.ps1",
    "android:sync": "npx cap sync android && npm run android:fix-java",
    "android:refresh-network": "npm run network:update && npm run build && npm run android:sync",
    "android:apk": "npm run build && npm run android:sync && cd android && gradlew.bat assembleDebug",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync && npm run android:fix-java",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "chart.js": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.3.1"
  }
}
